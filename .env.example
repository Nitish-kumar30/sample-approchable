# Vercel Blob (from Vercel project → Storage → Blob → Connect)
# Local dev: copy BLOB_READ_WRITE_TOKEN from the Vercel Blob store settings.
# On Vercel: connecting Blob to the project auto-injects BLOB_READ_WRITE_TOKEN and BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=
# Set automatically when Blob is connected on Vercel; required for OIDC auth if token is absent.
BLOB_STORE_ID=
# Admin (optional for now — open if unset)
# Optional admin gate (leave unset to show submissions without a secret)
# ADMIN_SECRET=
# n8n webhook for email notifications (optional — failures never block the form)
N8N_WEBHOOK_URL=
