{
  "version": 2,
  "name": "approachable-landing",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "env": {
    "COURSE_LIKES_KV_REST_API_URL": "@upstash_redis_rest_url",
    "COURSE_LIKES_KV_REST_API_TOKEN": "@upstash_redis_rest_token"
  }
}
